# MongoDB (local or Atlas)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=nexus_ai_commerce

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:8000

# Long random string. Typed into the Inventory / Campaigns / Audit tabs
# to unlock merchant tools. Merchant endpoints return 503 until it is set.
MERCHANT_API_KEY=change-me-to-a-long-random-string

# Razorpay Test Mode keys (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Webhook secret (Dashboard -> Webhooks). Events: payment.captured, payment.failed
# URL: {APP_URL}/api/orders/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# How long stock is held for an unpaid order
RESERVATION_MINUTES=15

# Gemini writes the chat replies and campaign copy (optional: without it the
# agent uses its deterministic reply)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
